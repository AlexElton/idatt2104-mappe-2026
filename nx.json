{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": ["{workspaceRoot}/Cargo.toml", "{workspaceRoot}/pnpm-workspace.yaml"]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "build-dev": {
      "cache": true,
      "inputs": ["default"]
    },
    "dev": {
      "cache": false
    }
  },
  "analytics": false
}
